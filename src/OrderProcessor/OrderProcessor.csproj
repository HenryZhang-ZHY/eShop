<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <PublishAot Condition="'$(EnableAotPublishing)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Application.UnitTests" />
  </ItemGroup>
  <!-- Built by Bazel and consumed as workspace packages (bazel run //:packages). -->
  <ItemGroup>
    <PackageReference Include="eShop.ServiceDefaults" />
    <PackageReference Include="EventBusRabbitMQ" />
  </ItemGroup>

</Project>
